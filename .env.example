# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP Settings: Set these for real password recovery emails to deliver to real inboxes.
# If left blank, the platform automatically falls back to an Ethereal catch-all client sandbox, providing preview links.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"

# Gmail SMTP Option (Simplest integration with Google Mail):
# 1. Enable 2-Step Verification in your Google Account
# 2. Generate a 16-character 'App Password' at https://myaccount.google.com/apppasswords
# 3. Supply those credentials here:
GMAIL_USER=""
GMAIL_PASS=""
